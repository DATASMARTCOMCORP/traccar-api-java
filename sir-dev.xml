<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
  <!-- Configuração básica para dispositivos móveis (HTTP/API) -->
  <entry key="web.enable">true</entry>
  <entry key="web.port">8082</entry>
  <!-- Porta padrão do SIR Web -->
  <entry key="web.address">0.0.0.0</entry>
  <!-- Permite conexões de qualquer IP local -->

  <!-- Habilita a API REST para o SIR Client -->
  <entry key="web.application">/opt/sir/sir-web.war</entry>
  <entry key="server.timeout">120</entry>

  <entry key="web.path">./traccar-web/simple</entry>
  <entry key="web.debug">true</entry>
  <entry key="web.console">true</entry>

  <entry key="geocoder.type">pluscodes</entry>

  <entry key="media.path">./target/media</entry>

  <entry key="logger.console">true</entry>
  <entry key="logger.queries">false</entry>
  <entry key="logger.fullStackTraces">true</entry>

  <!-- Sending emails doesn't work when mail.debug is true -->
  <!-- <entry key='mail.debug'>true</entry>  -->
  <entry key="mail.debug">false</entry>
  <entry key="mail.smtp.host">email-ssl.com.br</entry>
  <entry key="mail.smtp.port">587</entry>
  <entry key="mail.transport.protocol">smtp</entry>
  <entry key="mail.smtp.starttls.enable">true</entry>
  <entry key="mail.smtp.starttls.required">true</entry>
  <entry key="mail.smtp.auth">true</entry>
  <entry key="mail.smtp.username">atendimento@cetsp-digital.com.br</entry>
  <entry key="mail.smtp.password">YM$R7U}aRa</entry>
  <entry key="mail.smtp.from">atendimento@cetsp-digital.com.br</entry>
  <entry key="mail.smtp.fromName">Traccar</entry>

  <entry key="database.driver">org.postgresql.Driver</entry>
  <entry key="database.url">jdbc:postgresql://3.213.133.219:5432/traccar-dev</entry>
  <entry key="database.user">root</entry>
  <entry key="database.password">A1K1UYbtdt2n8llCTN0n</entry>

  <entry key="server.instantAcknowledgement">true</entry>
  <entry key="server.buffering.threshold">5000</entry>

  <entry key="atrack.custom">true</entry>
  <entry key="intellitrac.port">6037</entry>

  <entry key="osmand.port">5055</entry>
  <entry key="suntech.port">47762</entry>
  <entry key="suntech_udp.port">47763</entry>

  <!-- ===== SMS via TrackHub ===== -->

  <!-- Ativa o SMS na lista de notificadores disponíveis -->
  <entry key="notificator.types">web,mail,sms,command,firebase</entry>

  <!-- URL do endpoint SMS do TrackHub -->
  <entry key="sms.http.url">https://traccar.datasmartcom.com.br/api/notifications/sms</entry>

  <!-- Template JSON: os placeholders {phone} e {message} são substituídos pelo Traccar -->
  <entry key="sms.http.template">
    {
        "phone":"{phone}",
        "message":"{message}"
    }
  </entry>

  <!-- Encaminha eventos do Traccar para o TrackHub -->
  <entry key="event.forward.type">json</entry>
  <entry key="event.forward.url">https://traccar.datasmartcom.com.br/webhook/events</entry>
  <entry key="event.forward.header">Authorization: Bearer 62bf7ff8-f6fb-4135-94a0-f171313a0432</entry>
</properties>
